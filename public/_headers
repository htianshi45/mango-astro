# Cloudflare Pages 静态资源缓存策略
# 说明：带内容哈希的构建产物可以永久缓存；public 下的资源按目录给不同 TTL。
# HTML 保持 Pages 默认的 max-age=0（内容更新后立刻生效），不要给 *.html 加长缓存。

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 原图（灯箱点击时才加载）：固定文件名，只给 7 天 + 后台刷新
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 优化变体放在独立前缀，文件名带源图内容哈希，URL 随内容变化，可以永久缓存
/opt-images/*
  Cache-Control: public, max-age=31536000, immutable

/music/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
