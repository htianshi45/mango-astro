---
interface Comment {
  author: string;
  avatar: string;
  content: string;
  postTitle: string;
  postSlug: string;
  timestamp: string | Date;
}

interface Props {
  comments: Comment[];
  limit?: number;
}

const { comments, limit = 5 } = Astro.props;
const displayComments = comments.slice(0, limit);

function formatTime(date: string | Date): string {
  const d = new Date(date);
  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffDays = Math.floor(diffMs / 86400000);
  const diffMonths = Math.floor(diffDays / 30);
  
  if (diffMonths > 0) return `发布于${diffMonths} 月前`;
  if (diffDays > 0) return `发布于${diffDays} 天前`;
  return '发布于刚刚';
}
---

<aside class="widget">
  <h3 class="widget-title">最近评论</h3>
  <ul class="comment-list">
    {displayComments.map((comment) => (
      <li class="comment-item">
        <img src={comment.avatar} alt={comment.author} class="comment-avatar" />
        <div class="comment-content">
          <div class="comment-text">{comment.content}</div>
          <span class="comment-meta">
            <em>{comment.author}</em>
            <em>{formatTime(comment.timestamp)}</em>
          </span>
        </div>
      </li>
    ))}
  </ul>
</aside>

<style>
  .comment-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .comment-item {
    display: flex;
    gap: 12px;
    padding-bottom: 15px;
    margin-bottom: 15px;
    border-bottom: 1px solid #f0f0f0;
  }

  .comment-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .comment-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .comment-content {
    flex: 1;
    min-width: 0;
  }

  .comment-text {
    font-size: 13px;
    color: #333;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 6px;
  }

  .comment-meta {
    font-size: 12px;
    color: #999;
  }

  .comment-meta em {
    font-style: normal;
    margin-right: 8px;
  }

  :global(.dark) .comment-item {
    border-bottom-color: #252525;
  }

  :global(.dark) .comment-text {
    color: #ccc;
  }
</style>
