<button
  id="back-to-top"
  class="back-to-top-btn"
  aria-label="返回顶部"
>
  <i class="bi bi-arrow-up text-lg"></i>
</button>

<style>
  .back-to-top-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #000;
    color: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 40;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
  }

  .back-to-top-btn:hover {
    background: #4270f6;
  }

  .back-to-top-btn.visible {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  const backToTop = document.getElementById('back-to-top');
  
  if (backToTop) {
    // Show/hide based on scroll position
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTop.classList.add('visible');
      } else {
        backToTop.classList.remove('visible');
      }
    });

    // Scroll to top on click
    backToTop.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  }
</script>
