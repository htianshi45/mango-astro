---
/**
 * 右下角浮动按钮组
 *
 * 需求：日夜间切换 + 返回顶部两枚按钮，贴着「页面版心」的右边缘对齐，
 * 而不是钉在浏览器窗口最右侧（宽屏下会飘到内容之外的空白里）。
 *
 * 行为：
 *   - 主题按钮常驻，切换 html.dark，写 localStorage（键与 Halo 一致：isDarkMode / theme）；
 *   - 返回顶部在滚动 300px 后淡入，点击平滑回顶；
 *   - 位置由脚本按 <main> 的实际右边缘计算，窄屏（版心 = 满宽）自动退回贴边；
 *   - 窄屏（<=640px）整体缩小，避免挡住正文。
 */
---

<div class="float-tools" id="float-tools">
  <button
    id="theme-toggle"
    class="float-btn"
    aria-label="切换日间 / 夜间模式"
    aria-pressed="false"
    title="切换日间 / 夜间模式"
  >
    <i class="bi bi-sun-fill icon-sun"></i>
    <i class="bi bi-moon-stars-fill icon-moon"></i>
  </button>

  <button id="back-to-top" class="float-btn float-top" aria-label="返回顶部" title="返回顶部">
    <i class="bi bi-arrow-up"></i>
  </button>
</div>

<style>
  .float-tools {
    position: fixed;
    /* --float-right 由脚本按版心右边缘算出；没算出来之前退回 24px */
    right: var(--float-right, 24px);
    bottom: 30px;
    z-index: 45;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .float-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid rgba(8, 8, 8, 0.06);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: #4b5563;
    font-size: 17px;
    cursor: pointer;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 16px rgba(8, 8, 8, 0.12);
    transition: transform 0.22s ease, background-color 0.22s ease, color 0.22s ease,
      box-shadow 0.22s ease, opacity 0.25s ease, visibility 0.25s;
  }
  .float-btn:hover {
    background: #4270f5;
    border-color: #4270f5;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(66, 112, 245, 0.34);
  }
  .float-btn:active { transform: scale(0.94); }
  .float-btn:focus-visible { outline: 2px solid #4270f5; outline-offset: 3px; }

  /* 主题图标：浅色显示太阳（点击去暗），深色显示月亮 */
  .float-btn .icon-moon { display: none; }
  :global(.dark) .float-btn .icon-sun { display: none; }
  :global(.dark) .float-btn .icon-moon { display: inline-block; color: #ffc008; }
  :global(.dark) .float-btn {
    background: rgba(33, 33, 34, 0.92);
    border-color: rgba(255, 255, 255, 0.1);
    color: #d0d0d0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
  }
  :global(.dark) .float-btn:hover { background: #4270f5; color: #fff; }

  .float-top {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
  }
  .float-top.visible { opacity: 1; visibility: visible; transform: translateY(0); }

  @media (max-width: 640px) {
    .float-tools { bottom: 18px; gap: 8px; }
    .float-btn { width: 40px; height: 40px; font-size: 15px; }
  }

  @media print {
    .float-tools { display: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle');

  /* ---------- 贴版心右边缘 ---------- */
  const tools = document.getElementById('float-tools');
  const main = document.querySelector('main');

  const syncFloatX = () => {
    if (!tools) return;
    const viewport = document.documentElement.clientWidth;
    const rect = main?.getBoundingClientRect();
    const margin = rect ? viewport - rect.right : 0; // 版心右侧留白宽度
    const min = window.innerWidth <= 640 ? 14 : 16;
    // 留白够宽（≥68px）→ 按钮贴在版心外侧、紧挨内容右边缘，不压侧栏卡片；
    // 留白不够（窄屏）→ 退回版心内侧贴边，再不行就贴视口边。
    const outside = margin - 54;
    const inside = Math.max(min, margin + 6);
    tools.style.setProperty('--float-right', `${Math.max(min, outside >= min ? outside : inside)}px`);
  };

  syncFloatX();
  // 字体/图片加载完版心宽度可能变，再校准一次
  window.addEventListener('resize', syncFloatX);
  window.addEventListener('load', syncFloatX);

  const syncThemeLabel = () => {
    themeBtn?.setAttribute('aria-pressed', root.classList.contains('dark') ? 'true' : 'false');
  };
  syncThemeLabel();

  themeBtn?.addEventListener('click', () => {
    const isDark = root.classList.contains('dark');
    root.classList.toggle('dark', !isDark);
    try {
      localStorage.setItem('isDarkMode', isDark ? '0' : '1');
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
    } catch {
      /* 隐私模式下 localStorage 会抛错，忽略即可 */
    }
    syncThemeLabel();
  });

  const topBtn = document.getElementById('back-to-top');
  const onScroll = () => topBtn?.classList.toggle('visible', window.scrollY > 300);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  topBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
