---
/**
 * 文章阅读工具（P2-15）
 * - 发布超过一年时给出「内容可能已过时」提示
 * - 字号三档调节，选择记在 localStorage，刷新后保持
 * - 纯前端、无网络请求；打印时整块隐藏
 */
interface Props {
  published: Date | string;
}

const { published } = Astro.props;
const days = Math.max(0, Math.floor((Date.now() - new Date(published).getTime()) / 86_400_000));
const stale = days > 365;
const years = Math.floor(days / 365);
---

<div class="reading-tools">
  {stale && (
    <p class="rt-stale">
      <i class="bi bi-info-circle"></i>
      本文发布于 {years} 年前，部分内容可能已过时，请结合当前情况参考。
    </p>
  )}
  <div class="rt-size" role="group" aria-label="正文字号">
    <span class="rt-label"><i class="bi bi-text-paragraph"></i> 字号</span>
    <button type="button" data-font-size="small" aria-pressed="false">小</button>
    <button type="button" data-font-size="medium" aria-pressed="true">中</button>
    <button type="button" data-font-size="large" aria-pressed="false">大</button>
  </div>
</div>

<script>
  const KEY = 'mango:font-size';
  const SIZES = { small: '14px', medium: '16px', large: '18px' };
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-font-size]'));

  const apply = (size) => {
    const content = document.querySelector<HTMLElement>('.post-content');
    if (content) content.style.fontSize = SIZES[size] || '';
    buttons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.fontSize === size)));
  };

  let saved = 'medium';
  try { saved = localStorage.getItem(KEY) || 'medium'; } catch { /* 隐私模式 */ }
  if (!SIZES[saved]) saved = 'medium';
  apply(saved);

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const size = btn.dataset.fontSize || 'medium';
      apply(size);
      try { localStorage.setItem(KEY, size); } catch { /* 隐私模式 */ }
    });
  });
</script>

<style>
  .reading-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding: 10px 30px;
    margin-bottom: 0;
    background: #fff;
    font-size: 12px;
  }
  .rt-stale { margin: 0; color: #a8730f; display: inline-flex; align-items: center; gap: 6px; }
  .rt-stale i { font-size: 13px; }
  .rt-size { display: inline-flex; align-items: center; gap: 4px; margin-left: auto; }
  .rt-label { color: #999; margin-right: 4px; }
  .rt-size button {
    min-width: 28px;
    height: 24px;
    padding: 0 6px;
    border: 1px solid #e6e6e6;
    border-radius: 4px;
    background: #fff;
    color: #777;
    font-size: 12px;
    cursor: pointer;
  }
  .rt-size button:hover { border-color: #4270f5; color: #4270f5; }
  .rt-size button[aria-pressed="true"] { background: #4270f5; border-color: #4270f5; color: #fff; }
  .rt-size button:focus-visible { outline: 2px solid #4270f5; outline-offset: 2px; }

  :global(.dark) .reading-tools { background: #212121; }
  :global(.dark) .rt-stale { color: #dfb055; }
  :global(.dark) .rt-size button { background: #2a2a2a; border-color: #3a3a3a; color: #aaa; }
  :global(.dark) .rt-size button[aria-pressed="true"] { background: #4270f5; border-color: #4270f5; color: #fff; }

  @media (max-width: 640px) { .reading-tools { padding: 10px 20px; } }
</style>
