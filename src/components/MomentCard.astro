---
/**
 * 说说卡片 — 照搬 Mango 原主题首页的 post_loop「朋友圈」结构：
 *
 *   .post_loop_head      头像(40px 圆) + 昵称/时间 + 右上 ⋯
 *   .post_loop_conter    正文缩进 60px 与昵称对齐
 *     ├ 文字（说说正文）
 *     ├ 图片（Mango 朋友圈式错落九宫格，PostImages variant="mango"）
 *     ├ #标签 胶囊行
 *     └ 底部 meta 行（地点 / 全部说说），浅蓝色 12px，样式同 .post_info_footer
 */
import PostImages from './PostImages.astro';
import { renderMomentText } from '@/utils/mini-markdown';

interface Props {
  id: string;
  author: string;
  avatar: string;
  published: string | Date;
  pinned?: boolean;
  location?: string;
  tags?: string[];
  images?: string[];
  text: string;
  showTypeBadge?: boolean;
  /** 说说归档页是否启用；关闭后不渲染指向 404 的「全部说说」入口 */
  showArchiveLink?: boolean;
}

const {
  id,
  author,
  avatar,
  published,
  pinned = false,
  location = '',
  tags = [],
  images = [],
  text,
  showTypeBadge = true,
  showArchiveLink = true,
} = Astro.props;

function formatDate(date: string | Date): string {
  const d = new Date(date);
  if (Number.isNaN(d.getTime())) return '';
  const p = (n: number) => String(n).padStart(2, '0');
  return `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())} ${p(d.getUTCHours())}:${p(d.getUTCMinutes())}`;
}

const html = renderMomentText(text);
const permalink = `/moments/#moment-${id}`;
---

<article class="post-loop moment-card">
  <!-- 头部：头像 + 昵称/时间 + 右上操作 -->
  <div class="moment-head">
    <div class="moment-author">
      <img src={avatar} alt={author} class="moment-avatar" loading="lazy" />
      <div class="moment-author-name">
        <h3>{author}</h3>
        <span>{formatDate(published)}</span>
      </div>
    </div>
    <div class="moment-head-right">
      {pinned && <span class="moment-badge pinned"><i class="bi bi-pin-angle-fill"></i>置顶</span>}
      {showTypeBadge && <span class="moment-badge"><i class="bi bi-chat-square-dots"></i>说说</span>}
      <a class="moment-more" href={permalink} title="查看这条说说" aria-label="查看这条说说">
        <i class="bi bi-three-dots"></i>
      </a>
    </div>
  </div>

  <!-- 正文区：缩进与昵称对齐 -->
  <div class="moment-conter">
    <div class="moment-text" set:html={html}></div>

    {images.length > 0 && (
      <div class="moment-images">
        <PostImages images={images} slug={`moment-${id}`} variant="mango" />
      </div>
    )}

    {tags.length > 0 && (
      <div class="moment-tagrow">
        {tags.map((tag) => (
          <em>
            <i class="bi bi-hash"></i>
            <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>
          </em>
        ))}
      </div>
    )}

    <div class="moment-meta">
      {location && (
        <span class="moment-location"><i class="bi bi-geo-alt-fill"></i>{location}</span>
      )}
      {showArchiveLink && (
        <a href="/moments" class="moment-archive-link">全部说说 <i class="bi bi-arrow-right"></i></a>
      )}
    </div>
  </div>
</article>

<style>
  .moment-card {
    padding: 30px;
  }

  /* ===== 头部 ===== */
  .moment-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .moment-author { display: flex; align-items: center; }
  .moment-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    display: block;
  }
  .moment-author-name { margin-left: 15px; line-height: 1; }
  .moment-author-name h3 {
    margin: 0 0 2px;
    font-size: 14px;
    font-weight: 600;
    color: #333;
  }
  .moment-author-name span { font-size: 12px; color: #c6c6c6; font-weight: 300; }
  :global(.dark) .moment-author-name h3 { color: #d9d9d9; }
  :global(.dark) .moment-author-name span { color: #6e6e6e; }

  .moment-head-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .moment-more {
    display: inline-flex;
    color: #4270f5;
    text-decoration: none;
    line-height: 1;
  }
  .moment-more i { font-size: 24px; }
  .moment-more:hover { opacity: 0.75; }
  :global(.dark) .moment-more { color: #8ab0ff; }

  .moment-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(66, 112, 245, 0.1);
    color: #4270f5;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }
  .moment-badge.pinned { background: rgba(255, 159, 28, 0.14); color: #c98214; }
  :global(.dark) .moment-badge { background: rgba(138, 176, 255, 0.15); color: #8ab0ff; }
  :global(.dark) .moment-badge.pinned { background: rgba(255, 193, 7, 0.14); color: #ffc861; }

  /* ===== 正文区：缩进 60px 与昵称对齐（照抄 .post_loop_conter） ===== */
  .moment-conter { margin-left: 60px; min-width: 0; }

  .moment-text { font-size: 15px; line-height: 1.8; color: #444; margin-bottom: 14px; }
  .moment-text :global(p) { margin: 0 0 10px; }
  .moment-text :global(p:last-child) { margin-bottom: 0; }
  .moment-text :global(h3) { font-size: 16px; font-weight: 600; margin: 0 0 10px; color: #333; }
  .moment-text :global(strong) { font-weight: 700; color: #2b2b2b; }
  .moment-text :global(em) { font-style: italic; }
  .moment-text :global(a) { color: #4270f5; text-decoration: underline; text-underline-offset: 2px; }
  .moment-text :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em;
    background: #f2f4f8; color: #0c447c; padding: 2px 5px; border-radius: 4px;
  }
  :global(.dark) .moment-text { color: #c9c9c9; }
  :global(.dark) .moment-text :global(h3),
  :global(.dark) .moment-text :global(strong) { color: #e6e6e6; }
  :global(.dark) .moment-text :global(a) { color: #8ab0ff; }
  :global(.dark) .moment-text :global(code) { background: #2a2a2b; color: #a8c7ff; }

  .moment-images { margin: 0; }

  /* ===== #标签 胶囊行（照抄 .post_loop_tag） ===== */
  .moment-tagrow { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
  .moment-tagrow em {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    border-radius: 5px;
    padding: 3px 10px;
    font-size: 12px;
    font-style: inherit;
    background: #f5f7f9;
    color: #9bc2d9;
  }
  .moment-tagrow em a { color: inherit; text-decoration: none; }
  .moment-tagrow em:hover { background: #eef3f6; }
  :global(.dark) .moment-tagrow em { background: #343435; color: #9bc2d9; }
  :global(.dark) .moment-tagrow em:hover { background: #3d3d3f; }

  /* ===== 底部 meta（照抄 .post_info_footer） ===== */
  .moment-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 25px;
    margin-top: 18px;
    margin-left: 2px;
    font-size: 12px;
  }
  .moment-meta span,
  .moment-meta a {
    color: #a8c2d2;
    font-weight: 300;
    text-decoration: none;
  }
  .moment-meta span { display: inline-flex; align-items: center; gap: 6px; }
  .moment-meta a { display: inline-flex; align-items: center; gap: 4px; margin-left: auto; }
  .moment-meta a:hover { color: #4270f5; }
  :global(.dark) .moment-meta span,
  :global(.dark) .moment-meta a { color: #6f89a3; }
  :global(.dark) .moment-meta a:hover { color: #8ab0ff; }

  /* ===== 窄屏：缩进取消，跟原文一致 ===== */
  @media (max-width: 640px) {
    .moment-card { padding: 20px; }
    .moment-conter { margin-left: 0; }
  }

  /* ===== 宽屏：卡片内「内容」只占卡片宽度的 2/3，右边留白 =====
     头像行也跟着收窄，⋯ 与内容右边缘对齐，避免右侧空出一大块却只有图标 */
  @media (min-width: 1024px) {
    /* 正文占卡片内宽 2/3；头像行多出 60px 缩进，右边缘与正文对齐 */
    .moment-conter { width: 66.6667%; }
    .moment-head { width: calc(66.6667% + 60px); }
    /* 图片撑满这 2/3 的内容区（原版 88% 是相对整卡算的，这里会显得过窄） */
    .moment-images :global(.post-images--mango) { width: 100% !important; }
  }
</style>
