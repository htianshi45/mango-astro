---
/**
 * ⌘K / Ctrl+K 全局搜索弹层（P2-11）
 *
 * 与 /search 页共用同一份 Pagefind 索引，但逻辑独立、互不干扰。
 * 复用搜索页里踩过的坑：
 *   1) --force-language zh 的索引要求整个 init+search 期间 <html lang> 为 zh；
 *   2) 匹配不上时 search() 永久 pending，必须加超时；
 *   3) 超时或失败直接显示「打开完整搜索页」，不让弹层卡住。
 *
 * 未打开弹层时不加载 Pagefind 运行时，不影响首屏。
 */
---

<div class="sp-backdrop" id="search-palette" hidden>
  <div class="sp-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="sp-input-row">
      <i class="bi bi-search"></i>
      <input
        id="sp-input"
        type="search"
        placeholder="搜索文章、说说、收藏…"
        autocomplete="off"
        aria-label="搜索关键词"
      />
      <kbd>Esc</kbd>
    </div>
    <ul id="sp-results" class="sp-results" role="listbox" aria-label="搜索结果"></ul>
    <div class="sp-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择 · <kbd>Enter</kbd> 打开 · <kbd>Esc</kbd> 关闭</span>
      <a href="/search" id="sp-full">完整搜索页 <i class="bi bi-arrow-right"></i></a>
    </div>
  </div>
</div>

<script>
  const backdrop = document.getElementById('search-palette');
  const input = document.getElementById('sp-input');
  const results = document.getElementById('sp-results');
  const fullLink = document.getElementById('sp-full');

  const SITE_LANG = document.documentElement.lang || 'zh-CN';
  let langRefs = 0;
  let pfPromise = null;
  let seq = 0;
  let activeIndex = -1;
  let timer;

  const wait = (promise, ms) => {
    let t;
    return Promise.race([
      promise,
      new Promise((_, reject) => { t = setTimeout(() => reject(new Error('timeout')), ms); }),
    ]).finally(() => clearTimeout(t));
  };

  async function withZh(fn) {
    if (langRefs++ === 0) document.documentElement.lang = 'zh';
    try { return await fn(); }
    finally { if (--langRefs === 0) document.documentElement.lang = SITE_LANG; }
  }

  function loadPagefind() {
    if (!pfPromise) {
      const url = '/pagefind/pagefind.js';
      pfPromise = import(/* @vite-ignore */ url)
        .then(async (pf) => { await pf.init(); return pf; })
        .catch(() => null);
    }
    return pfPromise;
  }

  async function lookup(query) {
    try {
      return await withZh(async () => {
        // 首次加载 worker + 分片在慢网络下可能要 3-4 秒，超时给足余量；
        // 之后运行时已缓存，通常 0.4 秒内返回。
        const pf = await wait(loadPagefind(), 6000);
        if (!pf) return [];
        const res = await wait(pf.search(query), 6000);
        // 先多取一些再排序：相关度最高的前几条常常是标签聚合页，
        // 若先截 6 条再排序，正文页根本没有机会排进来。
        const data = await Promise.all((res?.results || []).slice(0, 20).map((item) => item.data()));
        // 标签/分类/归档页只是聚合页，排到正文内容页后面
        const isAux = (u = '') => /^\/(tags|categories|archive)\//.test(u) || u === '/archive/';
        data.sort((a, b) => Number(isAux(a.url)) - Number(isAux(b.url)));
        return data.slice(0, 6);
      });
    } catch {
      pfPromise = Promise.resolve(null);
      return [];
    }
  }

  function render(items, query) {
    if (!results) return;
    results.replaceChildren();
    activeIndex = -1;

    if (items.length === 0) {
    const li = document.createElement('li');
    li.className = 'sp-empty';
    li.textContent = query ? '没有匹配结果，按 Enter 打开完整搜索页' : '输入关键词开始搜索';
    results.appendChild(li);
    return;
  }

    items.forEach((item, index) => {
      const li = document.createElement('li');
      li.setAttribute('role', 'option');
      const a = document.createElement('a');
      a.href = item.url || '/';
      a.className = 'sp-item';
      a.dataset.index = String(index);
      const title = document.createElement('strong');
      title.textContent = item.meta?.title || item.url || '无标题';
      const excerpt = document.createElement('span');
      // Pagefind 的 excerpt 已转义正文，只保留 <mark> 高亮标签
      excerpt.innerHTML = item.excerpt || '';
      a.append(title, excerpt);
      li.appendChild(a);
      results.appendChild(li);
    });
  }

  // 必须定义在模块顶层：setTimeout 回调在这里调用它。
  // 若嵌套在 render() 内部，会被 tree-shake 掉并在运行时抛 ReferenceError。
  function renderLoading() {
    if (!results) return;
    results.replaceChildren();
    activeIndex = -1;
    const li = document.createElement('li');
    li.className = 'sp-empty';
    li.textContent = '正在搜索…';
    results.appendChild(li);
  }

  function setActive(next) {
    const links = Array.from(results?.querySelectorAll('.sp-item') || []);
    if (links.length === 0) return;
    activeIndex = (next + links.length) % links.length;
    links.forEach((link, i) => link.classList.toggle('is-active', i === activeIndex));
    links[activeIndex].scrollIntoView({ block: 'nearest' });
  }

  function open() {
    if (!backdrop) return;
    backdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    input?.focus();
  }

  function close() {
    if (!backdrop) return;
    backdrop.hidden = true;
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', (event) => {
    const key = event.key.toLowerCase();
    if ((event.metaKey || event.ctrlKey) && key === 'k') {
      event.preventDefault();
      backdrop?.hidden ? open() : close();
      return;
    }
    if (!backdrop || backdrop.hidden) return;
    if (key === 'escape') { close(); return; }
    if (key === 'arrowdown') { event.preventDefault(); setActive(activeIndex + 1); return; }
    if (key === 'arrowup') { event.preventDefault(); setActive(activeIndex - 1); return; }
    if (key === 'enter') {
      event.preventDefault();
      const active = results?.querySelector<HTMLAnchorElement>('.sp-item.is-active');
      if (active) window.location.href = active.href;
      else window.location.href = `/search?q=${encodeURIComponent(input?.value || '')}`;
    }
  });

  backdrop?.addEventListener('click', (event) => {
    if (event.target === backdrop) close();
  });

  // 移动端底栏没有键盘快捷键，用自定义事件打开同一个弹层
  document.addEventListener('open-search-palette', () => open());

  input?.addEventListener('input', () => {
    const query = (input.value || '').trim();
    if (fullLink) fullLink.href = `/search?q=${encodeURIComponent(query)}`;
    const my = ++seq;
    clearTimeout(timer);
    if (!query) { render([], ''); return; }
    timer = setTimeout(async () => {
      renderLoading();
      const items = await lookup(query);
      if (my !== seq) return;
      render(items, query);
    }, 200);
  });
</script>

<style>
  .sp-backdrop {
    position: fixed;
    inset: 0;
    z-index: 10001;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: min(14vh, 120px) 16px 16px;
    background: rgba(20, 20, 24, 0.55);
    backdrop-filter: blur(3px);
  }
  .sp-backdrop[hidden] { display: none; }

  .sp-panel {
    width: min(620px, 100%);
    background: #fff;
    border: 1px solid #e6e2da;
    border-radius: 14px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
    overflow: hidden;
  }

  .sp-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid #eee;
  }
  .sp-input-row i { color: #999; }
  .sp-input-row input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    color: #333;
  }
  kbd {
    display: inline-block;
    padding: 1px 6px;
    border: 1px solid #ddd;
    border-radius: 4px;
    background: #f7f7f7;
    color: #888;
    font: 11px ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .sp-results { list-style: none; margin: 0; padding: 6px; max-height: min(52vh, 420px); overflow-y: auto; }
  .sp-item { display: flex; flex-direction: column; gap: 3px; padding: 10px 12px; border-radius: 8px; text-decoration: none; }
  .sp-item:hover, .sp-item.is-active { background: #f2f5ff; }
  .sp-item strong { font-size: 14px; font-weight: 600; color: #333; }
  .sp-item span { font-size: 12px; color: #888; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  /* 结果由 innerHTML 动态生成，不带 scoped id，必须用纯全局选择器 */
  :global(.sp-item mark) { background: rgba(66, 112, 245, 0.16); color: inherit; padding: 0 2px; border-radius: 3px; }
  :global(.dark .sp-item mark) { background: rgba(138, 176, 255, 0.22); }
  .sp-empty { padding: 26px 12px; text-align: center; font-size: 13px; color: #999; }

  .sp-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    padding: 10px 18px;
    border-top: 1px solid #eee;
    font-size: 11.5px;
    color: #999;
  }
  .sp-foot a { color: #4270f5; text-decoration: none; }
  .sp-foot a:hover { text-decoration: underline; }

  :global(.dark) .sp-panel { background: #1e1d23; border-color: #3a3942; }
  :global(.dark) .sp-input-row, :global(.dark) .sp-foot { border-color: #33323a; }
  :global(.dark) .sp-input-row input { color: #e8e5df; }
  :global(.dark) kbd { background: #2a2a30; border-color: #444; color: #aaa; }
  :global(.dark) .sp-item:hover, :global(.dark) .sp-item.is-active { background: #2a3040; }
  :global(.dark) .sp-item strong { color: #e8e5df; }
  :global(.dark) .sp-item span { color: #9a9a9a; }
  :global(.dark) .sp-foot a { color: #8ab0ff; }
</style>
