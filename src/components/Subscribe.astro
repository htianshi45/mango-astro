---
/**
 * 邮件订阅（P1-7）
 *
 * 纯静态表单：把 siteConfig.subscribe.action 填成 Buttondown / follow.it
 * 等服务的订阅地址即可启用，不需要后端、不加载任何第三方 JS。
 * 未配置时整块不渲染。
 */
import { siteConfig } from '@/config/site';

const cfg = siteConfig.subscribe;
const hidden = Object.entries(cfg.hiddenFields || {});
---

{cfg.enabled && cfg.action && (
  <section class="subscribe-box" aria-label="邮件订阅">
    <h3><i class="bi bi-envelope"></i> 订阅更新</h3>
    <p>{cfg.note}</p>
    <form action={cfg.action} method="post" target="_blank" rel="noopener">
      {hidden.map(([name, value]) => <input type="hidden" name={name} value={value} />)}
      <label class="sr-only" for="subscribe-email">邮箱地址</label>
      <input
        id="subscribe-email"
        type="email"
        name={cfg.emailField}
        placeholder={cfg.placeholder}
        required
        autocomplete="email"
      />
      <button type="submit">订阅</button>
    </form>
  </section>
)}

<style>
  .subscribe-box {
    background: #fff;
    border-radius: 4px;
    padding: 20px 22px;
    margin-bottom: 20px;
  }
  .subscribe-box h3 { margin: 0 0 8px; font-size: 15px; font-weight: 600; color: #333; }
  .subscribe-box h3 i { color: #4270f5; margin-right: 6px; }
  .subscribe-box p { margin: 0 0 14px; font-size: 12.5px; color: #999; line-height: 1.7; }
  .subscribe-box form { display: flex; gap: 8px; }
  .subscribe-box input {
    flex: 1;
    min-width: 0;
    height: 38px;
    padding: 0 12px;
    border: 1px solid #e2e2e2;
    border-radius: 5px;
    font-size: 13px;
    color: #333;
    background: #fff;
  }
  .subscribe-box input:focus { outline: none; border-color: #4270f5; }
  .subscribe-box button {
    height: 38px;
    padding: 0 18px;
    border: none;
    border-radius: 5px;
    background: #4270f5;
    color: #fff;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
  }
  .subscribe-box button:hover { background: #0a59f8; }
  .subscribe-box button:focus-visible { outline: 2px solid #4270f5; outline-offset: 2px; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  :global(.dark) .subscribe-box { background: #212121; }
  :global(.dark) .subscribe-box h3 { color: #d9d9d9; }
  :global(.dark) .subscribe-box p { color: #777; }
  :global(.dark) .subscribe-box input { background: #191919; border-color: #3a3a3a; color: #ccc; }
</style>
