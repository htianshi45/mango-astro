---
/**
 * 评论区（P1-1）
 *
 * 默认关闭：siteConfig.comments.enabled = false 时这里不输出任何 DOM，
 * 也不会向 giscus.app 发请求，未配置时不拖慢页面、不影响隐私。
 *
 * 主题：giscus 的 preferred_color_scheme 只认系统设置，不认本站右上角的手动开关。
 * 这里用 postMessage 桥接——<html class="dark"> 一变就把 light/dark 推给 iframe，
 * 所以手动切暗色时评论区会跟着变。
 */
import { siteConfig } from '@/config/site';

interface Props {
  /** mapping 为 specific 时用作 discussion 的固定标识 */
  term?: string;
}

const { term = '' } = Astro.props;
const cfg = siteConfig.comments;
const g = cfg.giscus;
const ready = cfg.enabled && cfg.provider === 'giscus' && Boolean(g.repo && g.repoId && g.categoryId);
---

{ready && (
  <section class="comments-section" aria-label="评论">
    <div class="comments-head">
      <i class="bi bi-chat-square-dots"></i>
      <h2>评论</h2>
      <span>基于 GitHub Discussions</span>
    </div>
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={g.repo}
      data-repo-id={g.repoId}
      data-category={g.category}
      data-category-id={g.categoryId}
      data-mapping={g.mapping}
      data-term={g.mapping === 'specific' ? (term || g.term) : undefined}
      data-reactions-enabled={g.reactionsEnabled ? '1' : '0'}
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="zh-CN"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
    <script is:inline>
      // giscus 主题联动：本站手动切换暗色时，把主题推给 iframe。
      // preferred_color_scheme 只跟系统走，不推这一步会导致「页面黑了、评论框还是白的」。
      (function () {
        var ORIGIN = 'https://giscus.app';
        var root = document.documentElement;
        var last = null;

        function current() {
          return root.classList.contains('dark') ? 'dark' : 'light';
        }

        function push(force) {
          var frame = document.querySelector('iframe.giscus-frame');
          if (!frame || !frame.contentWindow) return;
          var theme = current();
          if (!force && theme === last) return;
          last = theme;
          frame.contentWindow.postMessage(
            { giscus: { setConfig: { theme: theme } } },
            ORIGIN
          );
        }

        // giscus 首次渲染完成会回发 message，此时 iframe 已就绪，必定对齐一次
        window.addEventListener('message', function (event) {
          if (event.origin !== ORIGIN) return;
          push(true);
        });

        // 手动点主题开关时 <html> 的 class 会变
        new MutationObserver(function () {
          push(false);
        }).observe(root, { attributes: true, attributeFilter: ['class'] });

        // 兜底：iframe 已存在但 message 回调错过的情况
        window.addEventListener('load', function () {
          setTimeout(function () {
            push(true);
          }, 1200);
        });
      })();
    </script>
  </section>
)}

<style>
  .comments-section {
    background: #fff;
    border-radius: 4px;
    padding: 24px 28px;
    margin-bottom: 20px;
  }

  .comments-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 18px;
  }

  .comments-head i { color: #4270f5; font-size: 15px; }
  .comments-head h2 { margin: 0; font-size: 15px; font-weight: 600; color: #333; }
  .comments-head span { margin-left: auto; font-size: 12px; color: #a8a8a8; }

  :global(.dark) .comments-section { background: #212121; }
  :global(.dark) .comments-head h2 { color: #d9d9d9; }
  :global(.dark) .comments-head span { color: #6e6e6e; }
</style>
