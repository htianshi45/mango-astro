---
/**
 * 收藏卡片 — 参考 Firefly 的 BilibiliCard.svelte（哔哩哔哩追番卡）
 *
 * 2026-11-07 二次调整：正文区只保留作品名，其余信息全部收进封面的 hover 遮罩：
 *   - 遮罩里：信息行（年份 / 作者 / 进度 / 标签）+ 简介 + 「查看详情」按钮；
 *   - 按钮跳转分两种：条目填了 url → 自定义链接（主色）；
 *     没填 url 但有 doubanUrl → 跳豆瓣详情页（豆瓣绿），两种样式不同；
 *   - 正文区的「标题」也是链接，跳转目标与按钮一致。
 */
import type { CollectionEntry } from 'astro:content';
import type { FavoriteCategoryMeta } from '@/config/favorites';
import { getStatusLabel } from '@/config/favorites';
import { renderMomentText } from '@/utils/mini-markdown';
import { imageAttrs } from '@/utils/image-attrs';

interface Props {
  item: CollectionEntry<'favorites'>;
  meta: FavoriteCategoryMeta;
}

const { item, meta } = Astro.props;
const d = item.data;
const statusLabel = getStatusLabel(meta, d.status);
const review = renderMomentText(item.body || '');
const letter = (d.title.trim()[0] || '#').toUpperCase();

const isExternal = (u = '') => /^https?:/i.test(u);
const hasCustomUrl = !!d.url;
const detailHref = d.url || d.doubanUrl || '';
const detailKind = hasCustomUrl ? 'custom' : detailHref ? 'douban' : '';

/** 遮罩里的正文：简介优先，没有简介就显示短评（Markdown 渲染结果） */
const hasDesc = !!d.description;

const infoParts = [d.creator, d.year].filter(Boolean);
const hoverInfo: string[] = [...infoParts];
if (meta.showProgress && d.progress > 0) hoverInfo.push(`进度 ${Math.min(100, d.progress)}%`);
---

<article
  class="fav-card"
  style={`--accent:${meta.accent};--ratio:${meta.coverRatio}`}
  data-status={d.status}
  data-search={`${d.title} ${d.creator} ${d.description} ${d.tags.join(' ')} ${d.year}`.toLowerCase()}
>
  <div class="fav-cover">
    {d.cover ? (
      <img {...imageAttrs(d.cover, { sizes: '(max-width: 640px) 45vw, 218px' })} alt={d.title} />
    ) : (
      <span class="fav-cover-letter">{letter}</span>
    )}

    <!-- 左上：状态 -->
    <span class="fav-status">{statusLabel}</span>
    <!-- 右上：评分 -->
    {d.rating > 0 && (
      <span class="fav-score"><i class="bi bi-star-fill"></i>{d.rating.toFixed(1)}</span>
    )}
    <!-- 左下：分类色块（对应 B 站卡的「来源」标签） -->
    <span class="fav-source">{meta.name}</span>

    <!-- hover 遮罩：年份 / 作者 / 进度 + 简介 + 跳转按钮 -->
    <div class="fav-mask">
      {hoverInfo.length > 0 && <p class="fav-mask-info">{hoverInfo.join(' · ')}</p>}
      {hasDesc && <p class="fav-mask-desc">{d.description}</p>}
      {!hasDesc && review && <p class="fav-mask-desc" set:html={review}></p>}
      {detailKind === 'custom' && (
        <a
          class="fav-mask-btn"
          href={d.url}
          {...(isExternal(d.url) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          查看详情 <i class="bi bi-box-arrow-up-right"></i>
        </a>
      )}
      {detailKind === 'douban' && (
        <a
          class="fav-mask-btn fav-mask-btn-douban"
          href={detailHref}
          {...(isExternal(detailHref) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          豆瓣详情 <i class="bi bi-arrow-up-right"></i>
        </a>
      )}
    </div>
  </div>

  <!-- 图片下面只保留作品名（点击跳转逻辑与遮罩按钮一致） -->
  <div class="fav-body">
    <h3 class="fav-title" title={d.title}>
      {detailHref ? (
        <a
          href={detailHref}
          {...(isExternal(detailHref) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >{d.title}</a>
      ) : (
        d.title
      )}
    </h3>
  </div>
</article>

<style>
  .fav-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #eceef2;
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.28s ease, box-shadow 0.28s ease, transform 0.28s ease;
  }
  .fav-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, #eceef2);
    box-shadow: 0 12px 28px -12px rgba(8, 8, 8, 0.28);
    transform: translateY(-3px);
  }
  :global(.dark) .fav-card { background: #212121; border-color: #333; }

  /* ===== 海报 ===== */
  .fav-cover {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 70%, #111), #2a2a2a);
    overflow: hidden;
  }
  .fav-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .fav-card:hover .fav-cover img { transform: scale(1.07); }
  .fav-cover-letter {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.55);
  }

  .fav-status {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 3px 8px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(6px);
    z-index: 2;
  }
  .fav-score {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 7px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.62);
    color: #ffd24a;
    backdrop-filter: blur(6px);
    z-index: 2;
  }
  .fav-source {
    position: absolute;
    bottom: 8px;
    left: 8px;
    padding: 2px 7px;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 600;
    color: #fff;
    background: color-mix(in srgb, var(--accent) 82%, transparent);
    backdrop-filter: blur(4px);
    z-index: 2;
  }

  /* hover 遮罩 */
  .fav-mask {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 12px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.88), rgba(0, 0, 0, 0.4) 55%, transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 3;
  }
  .fav-card:hover .fav-mask,
  .fav-card:focus-within .fav-mask { opacity: 1; }
  .fav-mask-info {
    margin: 0;
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fav-mask-desc {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fav-mask-desc :global(p) { margin: 0 0 4px; }
  .fav-mask-desc :global(p:last-child) { margin-bottom: 0; }
  .fav-mask-desc :global(img) { display: none; }

  /* 自定义链接：主色 */
  .fav-mask-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: 7px;
    background: var(--accent);
    color: #fff;
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    transition: filter 0.2s ease;
  }
  .fav-mask-btn:hover { filter: brightness(1.12); }

  /* 豆瓣详情：豆瓣绿，与自定义链接区分 */
  .fav-mask-btn-douban { background: #2ba257; }
  .fav-mask-btn-douban:hover { background: #33b765; }

  /* ===== 卡片文字区：只留作品名 ===== */
  .fav-body { padding: 9px 11px 11px; }
  .fav-title {
    margin: 0;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.45;
    color: #2f3238;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fav-title a { color: inherit; text-decoration: none; }
  .fav-title a:hover { color: var(--accent); }
  :global(.dark) .fav-title { color: #e6e6e6; }
</style>
