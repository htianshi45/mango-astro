---
/**
 * 收藏卡片 — 参考 Firefly 的 BilibiliCard.svelte（哔哩哔哩追番卡）
 *
 * 卡片结构完全对齐它：
 *   海报（按分类比例）→ 左上状态角标 + 右上评分角标 + 左下来源色块
 *   → hover 时从底部升起渐变遮罩，露出简介与「查看详情」按钮
 *   → 卡片下方只有标题、副标题（作者 / 年份）和一行进度或标签
 *
 * 四个库（收藏夹 / 书架 / 片库 / 音乐库）共用，差异由 meta 驱动。
 */
import type { CollectionEntry } from 'astro:content';
import type { FavoriteCategoryMeta } from '@/config/favorites';
import { getStatusLabel } from '@/config/favorites';
import { renderMomentText } from '@/utils/mini-markdown';

interface Props {
  item: CollectionEntry<'favorites'>;
  meta: FavoriteCategoryMeta;
}

const { item, meta } = Astro.props;
const d = item.data;
const statusLabel = getStatusLabel(meta, d.status);
const review = renderMomentText(item.body || '');
const letter = (d.title.trim()[0] || '#').toUpperCase();
const isExternal = /^https?:/i.test(d.url || '');
---

<article
  class="fav-card"
  style={`--accent:${meta.accent};--ratio:${meta.coverRatio}`}
  data-status={d.status}
  data-search={`${d.title} ${d.creator} ${d.description} ${d.tags.join(' ')} ${d.year}`.toLowerCase()}
>
  <div class="fav-cover">
    {d.cover ? (
      <img src={d.cover} alt={d.title} loading="lazy" decoding="async" />
    ) : (
      <span class="fav-cover-letter">{letter}</span>
    )}

    <!-- 左上：状态 -->
    <span class="fav-status">{statusLabel}</span>
    <!-- 右上：评分 -->
    {d.rating > 0 && (
      <span class="fav-score"><i class="bi bi-star-fill"></i>{d.rating.toFixed(1)}</span>
    )}
    <!-- 左下：分类色块（对应 B 站卡的「来源」标签） -->
    <span class="fav-source">{meta.name}</span>

    <!-- hover 遮罩：简介 + 查看详情 -->
    <div class="fav-mask">
      <p class="fav-mask-desc">{d.description || '还没有写简介'}</p>
      {d.url && (
        <a
          class="fav-mask-btn"
          href={d.url}
          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          查看详情 <i class="bi bi-arrow-up-right"></i>
        </a>
      )}
    </div>
  </div>

  <div class="fav-body">
    <h3 class="fav-title" title={d.title}>
      {d.url ? (
        <a href={d.url} {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{d.title}</a>
      ) : (
        d.title
      )}
    </h3>

    {(d.creator || d.year) && (
      <div class="fav-sub">
        {d.creator && <span>{d.creator}</span>}
        {d.creator && d.year && <span class="dot">·</span>}
        {d.year && <span>{d.year}</span>}
      </div>
    )}

    {meta.showProgress && d.progress > 0 ? (
      <div class="fav-progress">
        <div class="fav-progress-bar"><i style={`width:${Math.min(100, d.progress)}%`}></i></div>
        <span>{d.progress}%</span>
      </div>
    ) : (
      d.tags.length > 0 && (
        <div class="fav-tags">
          {d.tags.slice(0, 2).map((tag) => <span>#{tag}</span>)}
        </div>
      )
    )}

    {review && (
      <details class="fav-review">
        <summary>短评 <i class="bi bi-chevron-down"></i></summary>
        <div class="fav-review-text" set:html={review}></div>
      </details>
    )}
  </div>
</article>

<style>
  .fav-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #eceef2;
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.28s ease, box-shadow 0.28s ease, transform 0.28s ease;
  }
  .fav-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, #eceef2);
    box-shadow: 0 12px 28px -12px rgba(8, 8, 8, 0.28);
    transform: translateY(-3px);
  }
  :global(.dark) .fav-card { background: #212121; border-color: #333; }

  /* ===== 海报 ===== */
  .fav-cover {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 70%, #111), #2a2a2a);
    overflow: hidden;
  }
  .fav-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .fav-card:hover .fav-cover img { transform: scale(1.07); }
  .fav-cover-letter {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.55);
  }

  .fav-status {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 3px 8px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(6px);
    z-index: 2;
  }
  .fav-score {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 7px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.62);
    color: #ffd24a;
    backdrop-filter: blur(6px);
    z-index: 2;
  }
  .fav-source {
    position: absolute;
    bottom: 8px;
    left: 8px;
    padding: 2px 7px;
    border-radius: 5px;
    font-size: 10px;
    font-weight: 600;
    color: #fff;
    background: color-mix(in srgb, var(--accent) 82%, transparent);
    backdrop-filter: blur(4px);
    z-index: 2;
  }

  /* hover 遮罩 */
  .fav-mask {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 12px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.86), rgba(0, 0, 0, 0.35) 52%, transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 3;
  }
  .fav-card:hover .fav-mask,
  .fav-card:focus-within .fav-mask { opacity: 1; }
  .fav-mask-desc {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fav-mask-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 10px;
    border-radius: 7px;
    background: var(--accent);
    color: #fff;
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
    transition: filter 0.2s ease;
  }
  .fav-mask-btn:hover { filter: brightness(1.12); }

  /* ===== 卡片文字区 ===== */
  .fav-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 11px 12px;
    flex: 1;
  }
  .fav-title {
    margin: 0;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.45;
    color: #2f3238;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fav-title a { color: inherit; text-decoration: none; }
  .fav-title a:hover { color: var(--accent); }
  :global(.dark) .fav-title { color: #e6e6e6; }

  .fav-sub {
    display: flex;
    gap: 4px;
    font-size: 11.5px;
    color: #9aa3af;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fav-sub .dot { opacity: 0.6; }

  .fav-progress { display: flex; align-items: center; gap: 7px; margin-top: 3px; }
  .fav-progress-bar { flex: 1; height: 4px; border-radius: 99px; background: #eceef2; overflow: hidden; }
  :global(.dark) .fav-progress-bar { background: #3a3a3b; }
  .fav-progress-bar i { display: block; height: 100%; border-radius: 99px; background: var(--accent); }
  .fav-progress span { font-size: 10.5px; color: #9aa3af; min-width: 28px; text-align: right; }

  .fav-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 3px; }
  .fav-tags span {
    font-size: 10.5px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 1px 6px;
    border-radius: 5px;
  }

  .fav-review {
    margin-top: auto;
    padding-top: 6px;
    border-top: 1px dashed #f0f1f4;
    font-size: 11.5px;
  }
  :global(.dark) .fav-review { border-color: #3a3a3b; }
  .fav-review summary {
    list-style: none;
    cursor: pointer;
    color: #9aa3af;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .fav-review summary::-webkit-details-marker { display: none; }
  .fav-review summary i { font-size: 10px; transition: transform 0.2s ease; }
  .fav-review[open] summary i { transform: rotate(180deg); }
  .fav-review-text { margin-top: 6px; color: #666; line-height: 1.7; }
  .fav-review-text :global(p) { margin: 0 0 8px; }
  .fav-review-text :global(a) { color: var(--accent); }
  :global(.dark) .fav-review-text { color: #b0b6be; }
</style>
