---
/** 首页混合流渲染器：文章与说说共用同一个列表，按 FeedEntry.type 分派卡片 */
import PostCard from './PostCard.astro';
import MomentCard from './MomentCard.astro';
import type { FeedEntry } from '@/utils/feed';
import { isPageEnabled, siteConfig } from '@/config/site';
import { countWords, readingMinutes } from '@/utils/reading';

interface Props {
  entries: FeedEntry[];
  showTypeBadge?: boolean;
}

const { entries, showTypeBadge = true } = Astro.props;

// 列表形态：list = 横向图文卡单列；grid = 竖向卡两列（窄屏自动退回单列）
const isGrid = siteConfig.postListLayout.mode === 'grid';
const listClass = isGrid ? 'post-grid-2' : 'space-y-5';
---

<div class={listClass}>
  {entries.map((entry) => {
    if (entry.type === 'post') {
      const words = countWords(entry.post.body || '');
      return (
        <PostCard
          title={entry.post.data.title}
          slug={entry.post.slug}
          content={entry.post.data.description || ''}
          cover={entry.post.data.heroImage || entry.images[0] || ''}
          images={entry.images}
          timestamp={entry.post.data.pubDate}
          sticky={entry.sticky}
          tags={entry.post.data.tags}
          category={entry.post.data.category || ''}
          likes={entry.post.data.likes || 0}
          views={entry.post.data.views || 0}
          words={words}
          readingTime={readingMinutes(words)}
          typeBadge={showTypeBadge ? '文章' : ''}
        />
      );
    }

    return (
      <MomentCard
        id={entry.moment.id}
        author={entry.moment.data.author}
        avatar={entry.moment.data.avatar}
        published={entry.moment.data.published}
        pinned={entry.sticky}
        location={entry.moment.data.location}
        tags={entry.moment.data.tags}
        images={entry.images}
        text={entry.text}
        showTypeBadge={showTypeBadge}
        showArchiveLink={isPageEnabled('moments')}
      />
    );
  })}
</div>
