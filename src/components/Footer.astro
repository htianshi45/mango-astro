---
import { siteConfig, visibleFooterLinks } from '@/config/site';

const currentYear = new Date().getFullYear();
const links = visibleFooterLinks(siteConfig.footerLinks);
---

<footer class="site-footer">
  <div class="links">
    <div class="container mx-auto px-4 max-w-mango text-center">
      {links.map((link, index) => (
        <Fragment>
          {index > 0 && <span>|</span>}
          <a href={link.href}>{link.name}</a>
        </Fragment>
      ))}
    </div>
  </div>
  <div class="footbox">
    <div class="container mx-auto px-4 max-w-mango text-center">
      <p class="mb-2">
        &copy; {currentYear} {siteConfig.name}. All rights reserved.
      </p>
      <p class="text-xs opacity-75">
        Powered by <a href="https://astro.build" class="text-[#4270f5] hover:text-[#6b8ff7] transition-colors duration-200" target="_blank" rel="noopener">Astro</a>
      </p>
      {siteConfig.feed.rss && (
        <p class="text-xs opacity-50 mt-2">
          <a href="/rss.xml">RSS</a>
          <span class="mx-2">·</span>
          <a href="/atom.xml">Atom</a>
        </p>
      )}
      {siteConfig.icp && <p class="text-xs opacity-50 mt-2">{siteConfig.icp}</p>}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 30px;
  }

  .links {
    background: #272b30;
    padding: 25px 0;
    font-size: 12px;
  }

  .links a {
    color: #999;
    transition: color 0.2s;
  }

  .links a:hover {
    color: #fff;
  }

  .links span {
    color: #666;
    margin: 0 10px;
  }

  :global(.dark) .links {
    background: #1d1d1d;
  }

  .footbox {
    background: #1f2327;
    padding: 20px 0;
    color: #999;
    font-size: 12px;
  }
</style>
