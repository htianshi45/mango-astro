---
import AuthorCard from './AuthorCard.astro';
import HotPostsWidget from './HotPostsWidget.astro';
import TagsWidget from './TagsWidget.astro';
import MusicWidget from './MusicWidget.astro';
import TocWidget from './TocWidget.astro';

interface Post {
  title: string;
  slug: string;
  timestamp: string | Date;
  views?: number;
  excerpt?: string;
  heroImage?: string;
}

interface Tag {
  name: string;
  count: number;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  posts: Post[];
  tags: Tag[];
  /** 传了目录就渲染「目录」小工具（文章详情页用），首页不传 */
  toc?: Heading[];
  /** 文章页不放作者卡：正文下方已有作者与分享区，避免同屏出现两次 */
  showAuthor?: boolean;
  /** 文章页不重复放音乐播放器，保持首页的音乐入口 */
  showMusic?: boolean;
}

const { posts, tags, toc, showAuthor = true, showMusic = true } = Astro.props;

const hotPosts = [...posts]
  .sort((a, b) => (b.views || 0) - (a.views || 0))
  .slice(0, 3);
---

<aside class="space-y-5 sidebar_sticky">
  {toc && toc.length > 0 && <TocWidget items={toc} />}
  {showAuthor && <AuthorCard postCount={posts.length} tagCount={tags.length} />}
  {showMusic && <MusicWidget />}
  <HotPostsWidget posts={hotPosts} />
  <TagsWidget {tags} />
</aside>

<style>
  .sidebar_sticky {
    position: sticky;
    top: 95px;
  }

  /* 侧栏比屏幕高时 sticky 会让底部内容够不到，超长时允许自身滚动
     （滚到底会自然接力给页面，不用 contain 卡住） */
  @media (min-width: 1024px) {
    .sidebar_sticky {
      max-height: calc(100vh - 115px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(0, 0, 0, 0.16) transparent;
    }
    .sidebar_sticky::-webkit-scrollbar {
      width: 4px;
    }
    .sidebar_sticky::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.14);
      border-radius: 4px;
    }
    :global(.dark) .sidebar_sticky {
      scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
    }
    :global(.dark) .sidebar_sticky::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.16);
    }
  }
</style>
