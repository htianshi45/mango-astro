---
import AuthorCard from './AuthorCard.astro';
import HotPostsWidget from './HotPostsWidget.astro';
import TagsWidget from './TagsWidget.astro';
import MusicWidget from './MusicWidget.astro';

interface Post {
  title: string;
  slug: string;
  timestamp: string | Date;
  views?: number;
  excerpt?: string;
  heroImage?: string;
}

interface Tag {
  name: string;
  count: number;
}

interface Props {
  posts: Post[];
  tags: Tag[];
}

const { posts, tags } = Astro.props;

const hotPosts = [...posts]
  .sort((a, b) => (b.views || 0) - (a.views || 0))
  .slice(0, 3);
---

<aside class="space-y-5 sidebar_sticky">
  <!-- 作者卡（Firefly Profile 风） -->
  <AuthorCard postCount={posts.length} tagCount={tags.length} />
  <!-- 音乐播放器（Firefly Music 风） -->
  <MusicWidget />
  <HotPostsWidget posts={hotPosts} />
  <TagsWidget {tags} />
</aside>

<style>
  .sidebar_sticky {
    position: sticky;
    top: 95px;
  }
</style>
