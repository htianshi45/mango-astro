---
import '@/styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ThemeScript from '@components/ThemeScript.astro';
import FloatingTools from '@components/FloatingTools.astro';
import { siteConfig } from '@/config/site';

interface Props {
  title: string;
  description?: string;
  /** 文章封面图，用于 OG；不传则用站点 Logo */
  image?: string;
  /** website = 普通页面，article = 文章页（决定 JSON-LD 类型） */
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
  noindex?: boolean;
  /** true = 宽版心（主栏 + 边栏，1180px）；单栏阅读页保持 900px */
  wide?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  type = 'website',
  publishedTime,
  tags = [],
  noindex = false,
  wide = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/index\.html$/, '');
const canonical = new URL(pathname, siteConfig.url).href;
const ogImage = new URL(image || siteConfig.logo, siteConfig.url).href;

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage,
        url: canonical,
        ...(publishedTime ? { datePublished: publishedTime } : {}),
        author: { '@type': 'Person', name: siteConfig.author },
        publisher: {
          '@type': 'Organization',
          name: siteConfig.name,
          logo: { '@type': 'ImageObject', url: new URL(siteConfig.logo, siteConfig.url).href },
        },
        ...(tags.length ? { keywords: tags.join(',') } : {}),
        inLanguage: 'zh-CN',
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteConfig.name,
        description,
        url: siteConfig.url,
        inLanguage: 'zh-CN',
      };
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.keywords.join(', ')} />
    <meta name="author" content={siteConfig.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/fonts/bootstrap-icons.css" />
    {siteConfig.feed.rss && (
      <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href="/rss.xml" />
    )}
    {siteConfig.feed.atom && (
      <link rel="alternate" type="application/atom+xml" title={`${siteConfig.name} Atom`} href="/atom.xml" />
    )}
    {siteConfig.feed.sitemap && <link rel="sitemap" type="application/xml" href="/sitemap.xml" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="zh_CN" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 全站图片灯箱：静态资源，defer 保证 DOM 就绪；不经过 Astro 打包，避免样式被 scoped -->
    <script is:inline defer src="/js/lightbox.js"></script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
    <ThemeScript />
  </head>
  <body class="antialiased">
    <div class="min-h-screen flex flex-col">
      <Header />
      <main class:list={['flex-1 container mx-auto px-4', wide ? 'max-w-mango-wide' : 'max-w-mango']}>
        <slot />
      </main>
      <Footer />
      <FloatingTools />
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
</style>
