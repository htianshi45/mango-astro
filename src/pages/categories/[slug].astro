---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { extractImages } from '@/utils/post-images';
import { countWords, readingMinutes } from '@/utils/reading';
import { siteConfig } from '@/config/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = new Set<string>();
  posts.forEach(post => {
    if (post.data.category) categories.add(post.data.category);
  });
  // Also add categories from nav that may not have posts yet
  ['风景', '旅拍', '科技', '数码', '软件'].forEach(c => categories.add(c));
  return Array.from(categories).map(cat => ({
    params: { slug: cat },
    props: { categoryName: cat },
  }));
}

const { categoryName } = Astro.props;

const allPosts = await getCollection('posts', ({ data }) => data.draft !== true);
const posts = allPosts
  .filter(p => p.data.category === categoryName)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const tagCounts = new Map<string, number>();
allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
const tags = Array.from(tagCounts.entries()).map(([name, count]) => ({ name, count }));

const postData = allPosts.map(post => ({
  title: post.data.title,
  slug: post.id,
  timestamp: post.data.pubDate,
  views: post.data.views,
  heroImage: post.data.heroImage ?? extractImages(post.body)[0],
  excerpt: post.data.description,
}));

const isGrid = siteConfig.postListLayout.mode === 'grid';
---

<BaseLayout title={`${categoryName} - Mango`} wide>
  <div class="mb-6">
    <h1 class="text-xl font-bold text-[#333] dark:text-[#ccc]">
      <i class="bi bi-folder2-open mr-2 text-mango"></i>{categoryName}
    </h1>
    <p class="text-sm text-[#999] mt-1">共 {posts.length} 篇文章</p>
  </div>
  <div class="layout-sidebar">
    <div>
      <div class={isGrid ? 'post-grid-2' : 'space-y-5'}>
        {posts.length === 0 && (
          <div class="post-loop text-center py-12 text-[#999]">
            <i class="bi bi-inbox text-4xl block mb-3"></i>
            <p>该分类暂无文章</p>
          </div>
        )}
        {posts.map((post) => {
          const words = countWords(post.body || '');
          return (
            <PostCard
              title={post.data.title}
              slug={post.id}
              content={post.data.description || ''}
              cover={post.data.heroImage || extractImages(post.body)[0] || ''}
              images={extractImages(post.body)}
              timestamp={post.data.pubDate}
              tags={post.data.tags}
              category={post.data.category || ''}
              likes={post.data.likes || 0}
              views={post.data.views || 0}
              words={words}
              readingTime={readingMinutes(words)}
            />
          );
        })}
      </div>
    </div>
    <div>
      <Sidebar posts={postData} tags={tags} />
    </div>
  </div>
</BaseLayout>
