---
/**
 * 系列 / 专栏总览（P2-13）
 *
 * 在文章 frontmatter 里写 series: "系列名" 与 seriesOrder: 1 即可归组，
 * 文章页会自动出现「本系列」目录。没有系列时显示启用说明，不留空页面。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { groupSeries } from '@/utils/series';
import { siteConfig } from '@/config/site';

const posts = await getCollection('posts', ({ data }) => data.draft !== true);
const groups = groupSeries(posts);
const total = groups.reduce((sum, group) => sum + group.items.length, 0);
---

<BaseLayout title={`系列 - ${siteConfig.name}`} description="按主题整理成系列的长文合集。">
  <PageHeader
    icon="bi-collection"
    title="系列"
    description="把相关的长文按顺序排好，方便从头读到尾。"
    count={groups.length}
    unit="个系列"
  />

  {groups.length === 0 ? (
    <div class="series-empty">
      <i class="bi bi-journal-bookmark"></i>
      <h2>还没有系列文章</h2>
      <p>在文章的 frontmatter 里加两行就会自动出现在这里：</p>
      <pre><code>series: 折腾 NAS
seriesOrder: 1</code></pre>
      <p>同一系列的文章按 <code>seriesOrder</code> 从小到大排列，文章页底部也会显示整组目录。</p>
    </div>
  ) : (
    <div class="series-list">
      {groups.map((group) => (
        <section class="series-group">
          <h2><i class="bi bi-collection"></i>{group.name}<span>{group.items.length} 篇</span></h2>
          <ol>
            {group.items.map((post) => (
              <li>
                <a href={`/posts/${post.id}`}>
                  <span class="s-title">{post.data.title}</span>
                  <span class="s-date">{new Date(post.data.pubDate).toISOString().slice(0, 10)}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .series-list { display: grid; gap: 20px; margin-bottom: 30px; }
  .series-group { background: #fff; border-radius: 4px; padding: 22px 26px; }
  .series-group h2 {
    display: flex; align-items: center; gap: 8px;
    margin: 0 0 14px; font-size: 16px; font-weight: 600; color: #333;
  }
  .series-group h2 i { color: #4270f5; }
  .series-group h2 span { margin-left: auto; font-size: 12px; font-weight: 400; color: #999; }
  .series-group ol { margin: 0; padding-left: 22px; }
  .series-group li { padding: 7px 0; border-bottom: 1px dashed #eee; }
  .series-group li:last-child { border-bottom: none; }
  .series-group a {
    display: flex; justify-content: space-between; gap: 12px;
    color: #444; text-decoration: none; font-size: 14px;
  }
  .series-group a:hover { color: #4270f5; }
  .s-date { font-size: 12px; color: #aaa; white-space: nowrap; }

  .series-empty {
    background: #fff; border-radius: 4px; padding: 40px 30px;
    text-align: center; color: #777; margin-bottom: 30px;
  }
  .series-empty i { font-size: 34px; color: #4270f5; }
  .series-empty h2 { font-size: 17px; color: #333; margin: 12px 0; }
  .series-empty p { font-size: 13px; margin: 8px 0; }
  .series-empty pre {
    display: inline-block; text-align: left; background: #f7f8fa;
    padding: 12px 18px; border-radius: 6px; font-size: 12.5px; color: #333;
  }
  .series-empty code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

  :global(.dark) .series-group, :global(.dark) .series-empty { background: #212121; }
  :global(.dark) .series-group h2, :global(.dark) .series-empty h2 { color: #d9d9d9; }
  :global(.dark) .series-group li { border-bottom-color: #333; }
  :global(.dark) .series-group a { color: #bbb; }
  :global(.dark) .series-empty pre { background: #2a2a30; color: #ddd; }
</style>
