---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeedList from '@/components/FeedList.astro';
import Sidebar from '@/components/Sidebar.astro';
import Pagination from '@/components/Pagination.astro';
import LoadMore from '@/components/LoadMore.astro';
import { getCollection } from 'astro:content';
import { getMixedFeed, paginateFeed, buildSidebarData } from '@/utils/feed';
import { siteConfig } from '@/config/site';

export async function getStaticPaths() {
  // 用混合流总数算页数，避免第一页 8 条混合、第二页还是纯文章的错位
  const feed = await getMixedFeed();
  const totalPages = Math.ceil(feed.length / siteConfig.postsPerPage);
  if (totalPages <= 1) return [];
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const { entries, currentPage, totalPages } = paginateFeed(await getMixedFeed(), parseInt(page));

const posts = await getCollection('posts', ({ data }) => data.draft !== true);
const { tags, postData } = buildSidebarData(posts);
---

<BaseLayout title={`第 ${currentPage} 页 - ${siteConfig.name}`} wide indexable={false}>
  <div class="layout-sidebar">
    <div>
      <FeedList id="feed-list" entries={entries} showTypeBadge={siteConfig.home.showTypeBadge && siteConfig.home.includeMoments} />
      <LoadMore currentPage={currentPage} totalPages={totalPages} />
      <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/page" />
    </div>
    <div>
      <Sidebar posts={postData} tags={tags} />
    </div>
  </div>
</BaseLayout>
