---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/Sidebar.astro';
import Comments from '@/components/Comments.astro';
import PostStats from '@/components/PostStats.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config/site';
import { getSidebarData } from '@/utils/sidebar';
import { imageAttrs } from '@/utils/image-attrs';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection('posts', ({ data }) => data.draft !== true);
const sortedPosts = allPosts.sort((a, b) => {
  if (a.data.sticky !== b.data.sticky) return b.data.sticky - a.data.sticky;
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const newerPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const olderPost = currentIndex >= 0 && currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

// 相关文章：标签重合度优先，其次同分类，最后用时间衰减打破同分。
// 旧逻辑只按 category 过滤，未分类文章会退化成「最新 5 篇」，推荐质量很不稳定。
const ownTags = new Set(post.data.tags || []);
const ownTime = new Date(post.data.pubDate).getTime();
const displayRelated = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((candidate) => {
    const sharedTags = (candidate.data.tags || []).filter((tag) => ownTags.has(tag)).length;
    const sameCategory = post.data.category && candidate.data.category === post.data.category ? 1 : 0;
    const ageDays = Math.abs(ownTime - new Date(candidate.data.pubDate).getTime()) / 86_400_000;
    const proximity = Math.max(0, 1 - ageDays / 1080); // 3 年内线性衰减
    return {
      candidate,
      score: sharedTags * 3 + sameCategory * 2 + proximity,
      time: new Date(candidate.data.pubDate).getTime(),
    };
  })
  .sort((a, b) => b.score - a.score || b.time - a.time)
  .slice(0, 5)
  .map(({ candidate }) => candidate);

// 字数与阅读时间：剥离代码块、图片、链接与 Markdown 标记后统计
const plain = post.body
  .replace(/```[\s\S]*?```/g, '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/<[^>]+>/g, '')
  .replace(/[#>*`_~|\-]/g, '');
const cjkCount = (plain.match(/[\u4e00-\u9fff]/g) || []).length;
const enCount = (plain.replace(/[\u4e00-\u9fff]/g, ' ').match(/[a-zA-Z0-9]+/g) || []).length;
const wordCount = cjkCount + enCount;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 300));

const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const publishedTime = new Date(post.data.pubDate).toISOString();
const shareUrl = new URL(`/posts/${post.slug}`, siteConfig.url).href;
// 文章分享卡用 1200×630 的构建期生成图（npm run og），比封面原图更适配社交平台
const ogImage = `/og/posts/${post.slug}.jpg`;

// 文章页侧栏：目录 + 热门文章 + 标签（作者信息正文下方已有，不再重复）
const sidebar = await getSidebarData();
---

<BaseLayout
  title={`${post.data.title} - ${siteConfig.name}`}
  description={post.data.description || siteConfig.description}
  image={ogImage}
  type="article"
  publishedTime={publishedTime}
  tags={post.data.tags}
  wide
>
  {siteConfig.features.readingProgress && <div id="reading-progress" aria-hidden="true"></div>}

  <div class="layout-sidebar">
    <!-- 主栏：标题卡 / 正文卡 / 作者区 / 上下篇 / 相关文章 -->
    <div class="post-main">
      <!-- Section 1: Title Card -->
      <div class="post_container_title">
        <h1 class="text-xl font-bold text-[#333] dark:text-[#ccc] m-0">
          {post.data.title}
        </h1>
      </div>

      <!-- Section 2: Content Card -->
      <div class="post_container">
        {siteConfig.features.toc && tocItems.length > 0 && (
          <details class="post-toc">
            <summary>
              <i class="bi bi-list-ul mr-1"></i>目录 · {tocItems.length} 节
            </summary>
            <ul>
              {tocItems.map((h) => (
                <li class:list={['toc-depth-' + h.depth]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )}

        <!-- Post Content（图片随正文段落内嵌，不再顶部成组渲染） -->
        <div class="prose prose-lg dark:prose-invert max-w-none post-content">
          <Content />
        </div>

        <!-- Tags -->
        {post.data.tags.length > 0 && (
          <div class="mt-8 pt-5 border-t border-[#f0f0f0] dark:border-[#333]">
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="post-tag">
                  <i class="bi bi-hash" style="font-size: 12px;"></i>{tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Post Footer Data -->
        <div class="post-info-footer mt-6">
          {siteConfig.features.wordCount && (
            <span class="flex items-center">
              <i class="bi bi-file-text mr-1"></i>{wordCount.toLocaleString()} 字
            </span>
          )}
          {siteConfig.features.readingTime && (
            <span class="flex items-center">
              <i class="bi bi-clock mr-1"></i>约 {readingMinutes} 分钟
            </span>
          )}
          <PostStats slug={post.slug} views={post.data.views || 0} likes={post.data.likes || 0} />
        </div>
      </div>

      <!-- Section 3: Author Card (independent) -->
      <div class="post_author">
        <div class="flex items-center space-x-3">
          <img {...imageAttrs(post.data.avatar, { sizes: '28px', loading: 'eager' })} alt={post.data.author} class="w-7 h-7 rounded-full object-cover flex-shrink-0" />
          <div>
            <div class="text-sm font-medium text-[#333] dark:text-[#ccc]">{post.data.author}</div>
            <div class="text-xs text-[#999]">
              {new Date(post.data.pubDate).toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </div>
          </div>
        </div>
        {siteConfig.features.share && (
          <div class="flex items-center space-x-2">
            <button
              type="button"
              id="share-post"
              class="btn-primary text-xs py-1 px-3"
              style="background: #4270f5;"
              data-url={shareUrl}
              data-title={post.data.title}
            >
              <i class="bi bi-share mr-1"></i>分享
            </button>
            <button
              type="button"
              id="copy-link"
              class="btn-primary text-xs py-1 px-3"
              style="background: #4270f5;"
              data-url={shareUrl}
            >
              <i class="bi bi-link-45deg mr-1"></i>复制链接
            </button>
          </div>
        )}
      </div>

      <!-- Section 4: Previous / Next -->
      {siteConfig.features.postNavigation && (newerPost || olderPost) && (
        <div class="post-nav-grid">
          {olderPost ? (
            <a href={`/posts/${olderPost.slug}`} class="post-nav-item">
              <span class="post-nav-label"><i class="bi bi-arrow-left mr-1"></i>较早一篇</span>
              <span class="post-nav-title">{olderPost.data.title}</span>
            </a>
          ) : <span></span>}
          {newerPost ? (
            <a href={`/posts/${newerPost.slug}`} class="post-nav-item post-nav-right">
              <span class="post-nav-label">较新一篇<i class="bi bi-arrow-right ml-1"></i></span>
              <span class="post-nav-title">{newerPost.data.title}</span>
            </a>
          ) : <span></span>}
        </div>
      )}

      <!-- Section 5: Related Posts Card -->
      {siteConfig.features.relatedPosts && displayRelated.length > 0 && (
        <div class="post_related">
          <h3 class="widget-title mb-4">相关文章</h3>
          <ul class="space-y-2">
            {displayRelated.map((rp) => (
              <li class="text-sm">
                <a href={`/posts/${rp.slug}`} class="text-[#333] dark:text-[#ccc] hover:text-mango transition-colors duration-200 flex items-center">
                  <span class="w-1.5 h-1.5 rounded-full bg-mango mr-2 flex-shrink-0"></span>
                  {rp.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Section 6: 评论区（未配置 giscus 时不渲染） -->
      <Comments term={`/posts/${post.slug}`} />

      <!-- Navigation -->
      <div class="mt-5 flex justify-between">
        <a href="/" class="btn-secondary">
          <i class="bi bi-arrow-left mr-1"></i>返回首页
        </a>
      </div>
    </div>

    <!-- 侧栏：目录 / 热门文章 / 标签 -->
    <div>
      <Sidebar
        posts={sidebar.postData}
        tags={sidebar.tags}
        toc={tocItems}
        showMusic={false}
        showTags={false}
      />
    </div>
  </div>
</BaseLayout>

<script>
  // 阅读进度条
  const progressBar = document.getElementById('reading-progress');
  const updateProgress = () => {
    const total = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = total > 0 ? Math.min(100, Math.max(0, (window.scrollY / total) * 100)) : 0;
    if (progressBar) progressBar.style.width = ratio + '%';
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();

  // 分享与复制链接
  function toast(message) {
    const el = document.createElement('div');
    el.textContent = message;
    el.style.cssText = 'position:fixed;left:50%;bottom:32px;transform:translateX(-50%);z-index:10001;' +
      'background:rgba(0,0,0,.82);color:#fff;font-size:13px;padding:9px 16px;border-radius:20px;' +
      'opacity:0;transition:opacity .2s ease;pointer-events:none';
    document.body.appendChild(el);
    requestAnimationFrame(() => { el.style.opacity = '1'; });
    setTimeout(() => { el.style.opacity = '0'; setTimeout(() => el.remove(), 220); }, 1800);
  }

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch (err) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      ta.remove();
      return ok;
    }
  }

  document.getElementById('copy-link')?.addEventListener('click', async (e) => {
    const url = e.currentTarget.dataset.url;
    toast(await copyText(url) ? '链接已复制' : '复制失败，请手动复制地址栏');
  });

  document.getElementById('share-post')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const url = btn.dataset.url;
    const title = btn.dataset.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
        return;
      } catch (err) {
        if (err && err.name === 'AbortError') return;
      }
    }
    toast(await copyText(url) ? '链接已复制，可粘贴分享' : '复制失败，请手动复制地址栏');
  });

  // 代码块工具条：语言标签 + 一键复制（P1-8）
  // Shiki 输出形如 <pre class="astro-code github-dark" data-language="bash">，
  // 语言信息在 data-language 上，不在 class 里。
  document.querySelectorAll<HTMLElement>('.post-content pre').forEach((pre) => {
    if (pre.querySelector('.code-toolbar')) return;
    const code = pre.querySelector('code');
    if (!code) return;

    const lang = pre.dataset.language || 'text';
    const bar = document.createElement('div');
    bar.className = 'code-toolbar';

    const label = document.createElement('span');
    label.className = 'code-lang';
    label.textContent = lang;

    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.className = 'code-copy';
    copyBtn.setAttribute('aria-label', `复制 ${lang} 代码`);
    copyBtn.innerHTML = '<i class="bi bi-files"></i><span>复制</span>';

    bar.append(label, copyBtn);
    pre.prepend(bar);

    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    copyBtn.addEventListener('click', async () => {
      const ok = await copyText(code.textContent || '');
      const text = copyBtn.querySelector('span');
      if (text) text.textContent = ok ? '已复制' : '复制失败';
      copyBtn.classList.toggle('copied', ok);
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (text) text.textContent = '复制';
        copyBtn.classList.remove('copied');
      }, 1800);
    });
  });
</script>

<style>
  .post_container_title {
    background: #fff;
    padding: 25px 30px 20px;
    border-bottom: 2px solid #f0f0f0;
    border-radius: 4px 4px 0 0;
    margin-bottom: 0;
  }

  :global(.dark) .post_container_title {
    background: #212121;
    border-bottom-color: #333;
  }

  .post_container {
    background: #fff;
    padding: 30px 32px 20px;
    margin-bottom: 0;
  }

  :global(.dark) .post_container {
    background: #212121;
  }

  .post_author {
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 30px;
    border-top: 3px solid #f7f7f7;
    border-radius: 0 0 4px 4px;
    margin-bottom: 20px;
    margin-top: 0;
  }

  :global(.dark) .post_author {
    background: #212121;
    border-top-color: #333;
  }

  .post_related {
    background: #fff;
    padding: 25px 30px;
    border-radius: 4px;
    margin-bottom: 20px;
  }

  :global(.dark) .post_related {
    background: #212121;
  }

  :global(#reading-progress) {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: #4270f5;
    z-index: 9998;
    transition: width 0.1s linear;
  }

  .post-toc {
    background: #f7f8fa;
    border: 1px solid #e8eaed;
    border-radius: 8px;
    padding: 12px 18px;
    margin-bottom: 24px;
    font-size: 13px;
  }

  :global(.dark) .post-toc {
    background: #1d1d1f;
    border-color: #333;
  }

  .post-toc summary {
    cursor: pointer;
    color: #4270f5;
    font-weight: 500;
    list-style: none;
  }

  .post-toc summary::-webkit-details-marker {
    display: none;
  }

  .post-toc ul {
    margin: 12px 0 2px;
    padding-left: 18px;
    list-style: disc;
  }

  .post-toc li {
    margin: 5px 0;
    line-height: 1.6;
  }

  .post-toc a {
    color: #555;
    text-decoration: none;
  }

  :global(.dark) .post-toc a {
    color: #bbb;
  }

  .post-toc a:hover {
    color: #4270f5;
  }

  .post-toc .toc-depth-3 {
    margin-left: 16px;
    font-size: 12px;
  }

  /* 宽屏由侧栏目录接管，正文顶部的折叠目录只留窄屏 */
  @media (min-width: 1024px) {
    .post-toc {
      display: none;
    }
  }

  .post-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }

  .post-nav-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #fff;
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    padding: 16px 20px;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  :global(.dark) .post-nav-item {
    background: #212121;
    border-color: #333;
  }

  .post-nav-item:hover {
    border-color: #4270f5;
  }

  .post-nav-right {
    text-align: right;
  }

  .post-nav-label {
    font-size: 12px;
    color: #999;
  }

  .post-nav-title {
    font-size: 14px;
    color: #333;
    line-height: 1.5;
  }

  :global(.dark) .post-nav-title {
    color: #ccc;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  @media (max-width: 768px) {
    .post-nav-grid {
      grid-template-columns: 1fr;
    }
    .post_author {
      flex-wrap: wrap;
      gap: 12px;
    }
  }

  /* 代码块工具条：由脚本动态插入，必须写成 :global() 才能命中 */
  :global(.post-content pre) {
    position: relative;
    padding-top: 44px;
  }

  :global(.post-content .code-toolbar) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px 0 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(0, 0, 0, 0.16);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }

  :global(.post-content .code-lang) {
    color: #8b949e;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    user-select: none;
  }

  :global(.post-content .code-copy) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 5px;
    background: transparent;
    color: #b9c0c8;
    font-size: 12px;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.16s ease, border-color 0.16s ease;
  }

  :global(.post-content .code-copy:hover) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.38);
  }

  :global(.post-content .code-copy:focus-visible) {
    outline: 2px solid #8ab0ff;
    outline-offset: 2px;
  }

  :global(.post-content .code-copy.copied) {
    color: #7ee2a8;
    border-color: rgba(126, 226, 168, 0.5);
  }
</style>
