---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Sidebar from '@/components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config/site';
import { getSidebarData } from '@/utils/sidebar';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const allPosts = await getCollection('posts', ({ data }) => data.draft !== true);
const sortedPosts = allPosts.sort((a, b) => {
  if (a.data.sticky !== b.data.sticky) return b.data.sticky - a.data.sticky;
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const newerPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const olderPost = currentIndex >= 0 && currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 5);
const fallbackRelated = relatedPosts.length < 2
  ? allPosts.filter((p) => p.slug !== post.slug).slice(0, 5 - relatedPosts.length)
  : [];
const displayRelated = [...relatedPosts, ...fallbackRelated].slice(0, 5);

// 字数与阅读时间：剥离代码块、图片、链接与 Markdown 标记后统计
const plain = post.body
  .replace(/```[\s\S]*?```/g, '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/<[^>]+>/g, '')
  .replace(/[#>*`_~|\-]/g, '');
const cjkCount = (plain.match(/[\u4e00-\u9fff]/g) || []).length;
const enCount = (plain.replace(/[\u4e00-\u9fff]/g, ' ').match(/[a-zA-Z0-9]+/g) || []).length;
const wordCount = cjkCount + enCount;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 300));

const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const publishedTime = new Date(post.data.pubDate).toISOString();
const shareUrl = new URL(`/posts/${post.slug}`, siteConfig.url).href;
const ogImage = post.data.heroImage || post.data.images?.[0];

// 文章页侧栏：目录 + 热门文章 + 标签（作者信息正文下方已有，不再重复）
const sidebar = await getSidebarData();
---

<BaseLayout
  title={`${post.data.title} - ${siteConfig.name}`}
  description={post.data.description || siteConfig.description}
  image={ogImage}
  type="article"
  publishedTime={publishedTime}
  tags={post.data.tags}
  wide
>
  {siteConfig.features.readingProgress && <div id="reading-progress" aria-hidden="true"></div>}

  <div class="layout-sidebar">
    <!-- 主栏：标题卡 / 正文卡 / 作者区 / 上下篇 / 相关文章 -->
    <div class="post-main">
      <!-- Section 1: Title Card -->
      <div class="post_container_title">
        <h1 class="text-xl font-bold text-[#333] dark:text-[#ccc] m-0">
          {post.data.title}
        </h1>
      </div>

      <!-- Section 2: Content Card -->
      <div class="post_container">
        {siteConfig.features.toc && tocItems.length > 0 && (
          <details class="post-toc">
            <summary>
              <i class="bi bi-list-ul mr-1"></i>目录 · {tocItems.length} 节
            </summary>
            <ul>
              {tocItems.map((h) => (
                <li class:list={['toc-depth-' + h.depth]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )}

        <!-- Post Content（图片随正文段落内嵌，不再顶部成组渲染） -->
        <div class="prose prose-lg dark:prose-invert max-w-none post-content">
          <Content />
        </div>

        <!-- Tags -->
        {post.data.tags.length > 0 && (
          <div class="mt-8 pt-5 border-t border-[#f0f0f0] dark:border-[#333]">
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="post-tag">
                  <i class="bi bi-hash" style="font-size: 12px;"></i>{tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Post Footer Data -->
        <div class="post-info-footer mt-6">
          {siteConfig.features.wordCount && (
            <span class="flex items-center">
              <i class="bi bi-file-text mr-1"></i>{wordCount.toLocaleString()} 字
            </span>
          )}
          {siteConfig.features.readingTime && (
            <span class="flex items-center">
              <i class="bi bi-clock mr-1"></i>约 {readingMinutes} 分钟
            </span>
          )}
          <span class="flex items-center">
            <i class="bi bi-eye-fill mr-1"></i>
            {(post.data.views || 0).toLocaleString()} 浏览
          </span>
          <span class="flex items-center">
            <i class="bi bi-heart-fill mr-1"></i>
            {(post.data.likes || 0).toLocaleString()} 点赞
          </span>
        </div>
      </div>

      <!-- Section 3: Author Card (independent) -->
      <div class="post_author">
        <div class="flex items-center space-x-3">
          <img src={post.data.avatar} alt={post.data.author} class="w-7 h-7 rounded-full object-cover flex-shrink-0" />
          <div>
            <div class="text-sm font-medium text-[#333] dark:text-[#ccc]">{post.data.author}</div>
            <div class="text-xs text-[#999]">
              {new Date(post.data.pubDate).toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </div>
          </div>
        </div>
        {siteConfig.features.share && (
          <div class="flex items-center space-x-2">
            <button
              type="button"
              id="share-post"
              class="btn-primary text-xs py-1 px-3"
              style="background: #4270f5;"
              data-url={shareUrl}
              data-title={post.data.title}
            >
              <i class="bi bi-share mr-1"></i>分享
            </button>
            <button
              type="button"
              id="copy-link"
              class="btn-primary text-xs py-1 px-3"
              style="background: #4270f5;"
              data-url={shareUrl}
            >
              <i class="bi bi-link-45deg mr-1"></i>复制链接
            </button>
          </div>
        )}
      </div>

      <!-- Section 4: Previous / Next -->
      {siteConfig.features.postNavigation && (newerPost || olderPost) && (
        <div class="post-nav-grid">
          {olderPost ? (
            <a href={`/posts/${olderPost.slug}`} class="post-nav-item">
              <span class="post-nav-label"><i class="bi bi-arrow-left mr-1"></i>较早一篇</span>
              <span class="post-nav-title">{olderPost.data.title}</span>
            </a>
          ) : <span></span>}
          {newerPost ? (
            <a href={`/posts/${newerPost.slug}`} class="post-nav-item post-nav-right">
              <span class="post-nav-label">较新一篇<i class="bi bi-arrow-right ml-1"></i></span>
              <span class="post-nav-title">{newerPost.data.title}</span>
            </a>
          ) : <span></span>}
        </div>
      )}

      <!-- Section 5: Related Posts Card -->
      {siteConfig.features.relatedPosts && displayRelated.length > 0 && (
        <div class="post_related">
          <h3 class="widget-title mb-4">相关文章</h3>
          <ul class="space-y-2">
            {displayRelated.map((rp) => (
              <li class="text-sm">
                <a href={`/posts/${rp.slug}`} class="text-[#333] dark:text-[#ccc] hover:text-mango transition-colors duration-200 flex items-center">
                  <span class="w-1.5 h-1.5 rounded-full bg-mango mr-2 flex-shrink-0"></span>
                  {rp.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Navigation -->
      <div class="mt-5 flex justify-between">
        <a href="/" class="btn-secondary">
          <i class="bi bi-arrow-left mr-1"></i>返回首页
        </a>
      </div>
    </div>

    <!-- 侧栏：目录 / 热门文章 / 标签 -->
    <div>
      <Sidebar
        posts={sidebar.postData}
        tags={sidebar.tags}
        toc={tocItems}
        showMusic={false}
        showTags={false}
      />
    </div>
  </div>
</BaseLayout>

<script>
  // 阅读进度条
  const progressBar = document.getElementById('reading-progress');
  const updateProgress = () => {
    const total = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = total > 0 ? Math.min(100, Math.max(0, (window.scrollY / total) * 100)) : 0;
    if (progressBar) progressBar.style.width = ratio + '%';
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();

  // 分享与复制链接
  function toast(message) {
    const el = document.createElement('div');
    el.textContent = message;
    el.style.cssText = 'position:fixed;left:50%;bottom:32px;transform:translateX(-50%);z-index:10001;' +
      'background:rgba(0,0,0,.82);color:#fff;font-size:13px;padding:9px 16px;border-radius:20px;' +
      'opacity:0;transition:opacity .2s ease;pointer-events:none';
    document.body.appendChild(el);
    requestAnimationFrame(() => { el.style.opacity = '1'; });
    setTimeout(() => { el.style.opacity = '0'; setTimeout(() => el.remove(), 220); }, 1800);
  }

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch (err) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      ta.remove();
      return ok;
    }
  }

  document.getElementById('copy-link')?.addEventListener('click', async (e) => {
    const url = e.currentTarget.dataset.url;
    toast(await copyText(url) ? '链接已复制' : '复制失败，请手动复制地址栏');
  });

  document.getElementById('share-post')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const url = btn.dataset.url;
    const title = btn.dataset.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
        return;
      } catch (err) {
        if (err && err.name === 'AbortError') return;
      }
    }
    toast(await copyText(url) ? '链接已复制，可粘贴分享' : '复制失败，请手动复制地址栏');
  });
</script>

<style>
  .post_container_title {
    background: #fff;
    padding: 25px 30px 20px;
    border-bottom: 2px solid #f0f0f0;
    border-radius: 4px 4px 0 0;
    margin-bottom: 0;
  }

  :global(.dark) .post_container_title {
    background: #212121;
    border-bottom-color: #333;
  }

  .post_container {
    background: #fff;
    padding: 30px 32px 20px;
    margin-bottom: 0;
  }

  :global(.dark) .post_container {
    background: #212121;
  }

  .post_author {
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 30px;
    border-top: 3px solid #f7f7f7;
    border-radius: 0 0 4px 4px;
    margin-bottom: 20px;
    margin-top: 0;
  }

  :global(.dark) .post_author {
    background: #212121;
    border-top-color: #333;
  }

  .post_related {
    background: #fff;
    padding: 25px 30px;
    border-radius: 4px;
    margin-bottom: 20px;
  }

  :global(.dark) .post_related {
    background: #212121;
  }

  :global(#reading-progress) {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: #4270f5;
    z-index: 9998;
    transition: width 0.1s linear;
  }

  .post-toc {
    background: #f7f8fa;
    border: 1px solid #e8eaed;
    border-radius: 8px;
    padding: 12px 18px;
    margin-bottom: 24px;
    font-size: 13px;
  }

  :global(.dark) .post-toc {
    background: #1d1d1f;
    border-color: #333;
  }

  .post-toc summary {
    cursor: pointer;
    color: #4270f5;
    font-weight: 500;
    list-style: none;
  }

  .post-toc summary::-webkit-details-marker {
    display: none;
  }

  .post-toc ul {
    margin: 12px 0 2px;
    padding-left: 18px;
    list-style: disc;
  }

  .post-toc li {
    margin: 5px 0;
    line-height: 1.6;
  }

  .post-toc a {
    color: #555;
    text-decoration: none;
  }

  :global(.dark) .post-toc a {
    color: #bbb;
  }

  .post-toc a:hover {
    color: #4270f5;
  }

  .post-toc .toc-depth-3 {
    margin-left: 16px;
    font-size: 12px;
  }

  /* 宽屏由侧栏目录接管，正文顶部的折叠目录只留窄屏 */
  @media (min-width: 1024px) {
    .post-toc {
      display: none;
    }
  }

  .post-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }

  .post-nav-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #fff;
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    padding: 16px 20px;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  :global(.dark) .post-nav-item {
    background: #212121;
    border-color: #333;
  }

  .post-nav-item:hover {
    border-color: #4270f5;
  }

  .post-nav-right {
    text-align: right;
  }

  .post-nav-label {
    font-size: 12px;
    color: #999;
  }

  .post-nav-title {
    font-size: 14px;
    color: #333;
    line-height: 1.5;
  }

  :global(.dark) .post-nav-title {
    color: #ccc;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  @media (max-width: 768px) {
    .post-nav-grid {
      grid-template-columns: 1fr;
    }
    .post_author {
      flex-wrap: wrap;
      gap: 12px;
    }
  }
</style>
