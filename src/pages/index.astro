---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Banner from '@/components/Banner.astro';
import FeedList from '@/components/FeedList.astro';
import Sidebar from '@/components/Sidebar.astro';
import Pagination from '@/components/Pagination.astro';
import { getCollection } from 'astro:content';
import { getMixedFeed, paginateFeed, buildSidebarData } from '@/utils/feed';
import { siteConfig } from '@/config/site';

// 首页 = 文章 + 说说 的同一条时间流；与 /page/N 共用 getMixedFeed，顺序不会错位
const feed = await getMixedFeed();
const { entries, currentPage, totalPages } = paginateFeed(feed, 1);

// 侧栏仍只统计文章
const posts = await getCollection('posts', ({ data }) => data.draft !== true);
const { tags, postData } = buildSidebarData(posts);
---

<BaseLayout title={`首页 - ${siteConfig.name}`} wide>
  <Banner />
  <div class="layout-sidebar">
    <!-- 混合时间流（主栏 : 边栏 = 3 : 1，边栏 281px 固定） -->
    <div>
      <FeedList entries={entries} showTypeBadge={siteConfig.home.showTypeBadge} />
      {totalPages > 1 && (
        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/" />
      )}
    </div>

    <!-- 侧栏 -->
    <div>
      <Sidebar posts={postData} tags={tags} />
    </div>
  </div>
</BaseLayout>
