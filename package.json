{
  "name": "mango-astro",
  "type": "module",
  "version": "1.0.0",
  "description": "Mango theme replica for Astro - WeChat Moments style photo blog",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run check:content && npm run images && npm run og && astro build && npm run search:index",
    "check:content": "node scripts/check-content.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "fav": "node scripts/fav-add.mjs",
    "fav:ui": "node scripts/fav-ui.mjs",
    "fav:cover": "node scripts/fav-cover.mjs",
    "icons": "/Users/ming/.workbuddy/binaries/python/envs/default/bin/python scripts/subset-icons.py",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/gen-og.mjs",
    "search:index": "pagefind --site dist --force-language zh --exclude-selectors \"header,footer,aside,nav,script,style\"",
    "push:indexnow": "node scripts/push-indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/mdx": "^8.1.5",
    "@sveltia/cms": "^0.261.0",
    "@tailwindcss/typography": "^0.5.10",
    "astro": "^7.4.10",
    "bootstrap-icons": "^1.13.2",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pagefind": "^1.6.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0"
  }
}
